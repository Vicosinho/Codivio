<!doctype html>
<html lang="pt-br">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Codivio</title>
  <style>
    :root {
      --bg: #0f1220;
      --panel: #151a2b;
      --muted: #7a87a3;
      --text: #e6eaf2;
      --accent: #6ee7b7;
      --accent-2: #60a5fa;
      --danger: #f87171;
      --border: #23304a;
    }

    * { box-sizing: border-box }
    html, body { height: 100% }

    body {
      margin: 0;
      font: 14px/1.45 system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      color: var(--text);
      background: linear-gradient(180deg, #0d1020 0%, #0b1224 100%);
    }

    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 16px;
      border-bottom: 1px solid var(--border);
      background: rgba(15, 18, 32, .6);
      backdrop-filter: saturate(1.2) blur(6px);
      position: sticky;
      top: 0;
      z-index: 10;
      gap: 12px;
    }

    header h1 { margin: 0; font-size: 16px; letter-spacing: .3px; color: #fff }
    header .badge { font-size: 12px; color: var(--muted) }
    .hint { margin: 0; color: #aab4cf; font-size: 12px }

    .wrap {
      display: grid;
      gap: 10px;
      grid-template-columns: 1fr 1fr;
      padding: 10px;
      height: calc(100dvh - 58px);
    }

    @media (max-width: 900px) {
      .wrap { grid-template-columns: 1fr; height: auto }
    }

    .panel {
      display: flex; flex-direction: column; min-height: 320px;
      background: linear-gradient(180deg, rgba(21, 26, 43, .9), rgba(21, 26, 43, .85));
      border: 1px solid var(--border); border-radius: 10px; overflow: hidden;
      box-shadow: 0 10px 30px rgba(0,0,0,.25), inset 0 1px 0 rgba(255,255,255,.02);
    }

    .panel-head {
      display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap;
      padding: 10px 12px; border-bottom: 1px solid var(--border); background: rgba(18, 23, 40, .6);
    }

    .panel-title { font-weight: 600; color: #cfd8ea; font-size: 13px }

    .controls { display: flex; gap: 8px; align-items: center; flex-wrap: wrap }
    .controls .group { display: flex; gap: 8px; align-items: center }

    .btn {
      appearance: none; border: 1px solid var(--border); background: #0f1425; color: var(--text);
      padding: 8px 10px; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 12px; transition: .2s ease;
    }
    .btn:hover { filter: brightness(1.1) }
    .btn:disabled { opacity: .6; cursor: not-allowed }
    .btn.accent { border-color: transparent; background: linear-gradient(90deg, var(--accent) 0%, var(--accent-2) 100%); color: #08101e }
    .btn.danger { border-color: #3c1f26; background: #2a0f14; color: #ffd9de }
    .btn.tab { background: #0f1425 }
    .btn.tab.active { border-color: var(--accent-2); color: var(--accent-2); box-shadow: inset 0 0 0 1px rgba(96,165,250,.2) }

    .tick { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--muted) }

    /* Editor com números de linha */
    .editor-wrap { display: flex; height: 100%; background: #0c1120; color: #e7ecf7; font: 13px/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace }
    .line-numbers { background: #0f1425; color: var(--muted); border-right: 1px solid var(--border); min-width: 48px; user-select: none; overflow: hidden }
    .line-numbers-inner { padding: 12px 8px 12px 10px; text-align: right; white-space: pre; line-height: 1.5; font: inherit }
    .code { flex: 1; border: 0; resize: none; outline: none; padding: 12px 14px; background: transparent; color: inherit; font: inherit; line-height: 1.5; tab-size: 2; caret-color: #7dd3fc; overflow: auto }

    iframe { width: 100%; height: 100%; border: 0; background: #ffffff; border-top: 1px solid var(--border) }
    .status { font-size: 12px; color: var(--muted); padding: 8px 12px; border-top: 1px solid var(--border); background: rgba(18, 23, 40, .6) }

    /* Modal base */
    .modal-overlay { position: fixed; inset: 0; background: rgba(8, 12, 24, 0.85); backdrop-filter: blur(4px); display: flex; align-items: center; justify-content: center; z-index: 100; padding: 20px }
    .modal { background: var(--panel); border: 1px solid var(--border); border-radius: 12px; width: 100%; max-width: 400px; box-shadow: 0 20px 40px rgba(0,0,0,.4); overflow: hidden }
    .modal-header { padding: 16px 20px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between }
    .modal-title { font-weight: 600; font-size: 16px }
    .modal-close { background: none; border: none; color: var(--muted); font-size: 20px; cursor: pointer; padding: 0; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; border-radius: 6px }
    .modal-close:hover { background: rgba(255,255,255,.05) }
    .modal-body { padding: 20px }
    .form-group { margin-bottom: 16px }
    .form-label { display: block; margin-bottom: 6px; font-size: 13px; color: #cfd8ea }
    .form-input { width: 100%; padding: 10px 12px; border: 1px solid var(--border); background: #0f1425; border-radius: 8px; color: var(--text); font: inherit }
    .form-input:focus { outline: none; border-color: var(--accent-2); box-shadow: 0 0 0 2px rgba(96,165,250,.2) }
    .form-error { color: var(--danger); font-size: 12px; margin-top: 6px; display: none }
    .form-error.show { display: block }
    .modal-footer { padding: 16px 20px 20px; border-top: 1px solid var(--border); display: flex; flex-direction: column; gap: 12px }
    .modal-action { width: 100%; padding: 10px; border-radius: 8px; border: none; font-weight: 600; cursor: pointer; font-size: 14px }
    .btn-primary { background: linear-gradient(90deg, var(--accent) 0%, var(--accent-2) 100%); color: #08101e }
    .btn-secondary { background: transparent; border: 1px solid var(--border); color: var(--text) }

    .auth-tabs { display: flex; margin-bottom: 20px; background: #0f1425; border-radius: 8px; padding: 4px }
    .auth-tab { flex: 1; padding: 8px; text-align: center; background: transparent; border: none; color: var(--muted); border-radius: 6px; cursor: pointer; font-weight: 600; font-size: 13px }
    .auth-tab.active { background: rgba(96,165,250,.15); color: var(--accent-2) }

    .user-menu { position: relative }
    .user-btn { display: flex; align-items: center; gap: 8px; background: rgba(96,165,250,.1); border: 1px solid rgba(96,165,250,.2); color: var(--accent-2); padding: 6px 12px; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 13px }
    .user-dropdown { position: absolute; top: 100%; right: 0; margin-top: 8px; background: var(--panel); border: 1px solid var(--border); border-radius: 8px; min-width: 160px; box-shadow: 0 10px 30px rgba(0,0,0,.3); display: none; z-index: 20 }
    .user-dropdown.show { display: block }
    .user-dropdown-item { display: block; width: 100%; padding: 10px 14px; background: none; border: none; text-align: left; color: var(--text); cursor: pointer; font-size: 13px }
    .user-dropdown-item:hover { background: rgba(96,165,250,.1) }
    .user-dropdown-divider { height: 1px; background: var(--border); margin: 4px 0 }

    .profile-info { background: #0f1425; border-radius: 8px; padding: 16px; margin-bottom: 20px }
    .profile-field { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border) }
    .profile-field:last-child { border-bottom: none }
    .profile-label { color: var(--muted); font-weight: 500 }
    .profile-value { color: var(--text) }
  </style>

  <!-- Firebase App e Services (Compat v9) -->
  <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-auth-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-firestore-compat.js"></script>
</head>

<body>
  <header>
    <h1>Codivio<span class="badge">__Editor de Código</span></h1>
    <p class="hint">Dica: ative "Auto atualizar" para ver mudanças em tempo real.</p>
    <div id="auth-section">
      <button id="login-btn" class="btn accent">Entrar / Cadastrar</button>
      <div id="user-section" class="user-menu" style="display:none">
        <button id="user-btn" class="user-btn"><span id="user-name">Usuário</span><span>▼</span></button>
        <div id="user-dropdown" class="user-dropdown">
          <button class="user-dropdown-item" id="profile-btn">Meu Perfil</button>
          <div class="user-dropdown-divider"></div>
          <button class="user-dropdown-item" id="logout-btn">Sair</button>
        </div>
      </div>
    </div>
  </header>

  <main class="wrap">
    <section class="panel" aria-label="Editor de código">
      <div class="panel-head">
        <div class="panel-title">Editor</div>
        <div class="controls">
          <div class="group" role="group" aria-label="Seleção de nota">
            <button class="btn tab" data-note="1">Nota 1</button>
            <button class="btn tab" data-note="2">Nota 2</button>
            <button class="btn tab" data-note="3">Nota 3</button>
          </div>
          <div class="group">
            <label class="tick"><input id="auto" type="checkbox" checked /> Auto atualizar</label>
          </div>
          <div class="group">
            <button id="run" class="btn accent">Executar</button>
            <button id="reset" class="btn danger">Limpar</button>
            <button id="download" class="btn">Baixar .html</button>
          </div>
        </div>
      </div>

      <div class="editor-wrap">
        <div class="line-numbers"><pre id="lnContent" class="line-numbers-inner">1</pre></div>
        <textarea id="code" class="code" spellcheck="false"></textarea>
      </div>
      <div class="status" id="status">Pronto</div>
    </section>

    <section class="panel" aria-label="Visualização do HTML">
      <div class="panel-head">
        <div class="panel-title">Visualização</div>
        <div class="controls"><button id="popup" class="btn">Abrir em nova aba</button></div>
      </div>
      <iframe id="preview" title="Pré-visualização" sandbox="allow-forms allow-modals allow-pointer-lock allow-popups allow-scripts"></iframe>
      <div class="status">Isolado em iframe com sandbox</div>
    </section>
  </main>

  <!-- Modal de Autenticação -->
  <div id="auth-modal" class="modal-overlay" style="display:none">
    <div class="modal">
      <div class="modal-header">
        <div class="modal-title">Autenticação</div>
        <button class="modal-close" id="modal-close">×</button>
      </div>
      <div class="modal-body">
        <div class="auth-tabs">
          <button class="auth-tab active" data-tab="login">Entrar</button>
          <button class="auth-tab" data-tab="register">Criar Conta</button>
        </div>

        <form id="login-form">
          <div class="form-group">
            <label class="form-label" for="login-email">E-mail</label>
            <input type="email" id="login-email" class="form-input" required>
            <div class="form-error" id="login-email-error"></div>
          </div>
          <div class="form-group">
            <label class="form-label" for="login-password">Senha</label>
            <input type="password" id="login-password" class="form-input" required>
            <div class="form-error" id="login-password-error"></div>
          </div>
          <div class="form-error" id="login-error"></div>
        </form>

        <form id="register-form" style="display:none">
          <div class="form-group">
            <label class="form-label" for="register-name">Nome</label>
            <input type="text" id="register-name" class="form-input" required>
            <div class="form-error" id="register-name-error"></div>
          </div>
          <div class="form-group">
            <label class="form-label" for="register-email">E-mail</label>
            <input type="email" id="register-email" class="form-input" required>
            <div class="form-error" id="register-email-error"></div>
          </div>
          <div class="form-group">
            <label class="form-label" for="register-password">Senha</label>
            <input type="password" id="register-password" class="form-input" required>
            <div class="form-error" id="register-password-error"></div>
          </div>
          <div class="form-group">
            <label class="form-label" for="register-confirm">Confirmar Senha</label>
            <input type="password" id="register-confirm" class="form-input" required>
            <div class="form-error" id="register-confirm-error"></div>
          </div>
          <div class="form-error" id="register-error"></div>
        </form>
      </div>
      <div class="modal-footer">
        <button id="auth-submit" class="modal-action btn-primary">Entrar</button>
        <button class="modal-action btn-secondary" id="auth-switch">Criar uma conta</button>
      </div>
    </div>
  </div>

  <!-- Modal de Perfil -->
  <div id="profile-modal" class="modal-overlay" style="display:none">
    <div class="modal">
      <div class="modal-header">
        <div class="modal-title">Informações da Conta</div>
        <button class="modal-close" id="profile-modal-close">×</button>
      </div>
      <div class="modal-body">
        <div class="profile-info">
          <div class="profile-field"><span class="profile-label">Nome:</span><span class="profile-value" id="profile-name"></span></div>
          <div class="profile-field"><span class="profile-label">E-mail:</span><span class="profile-value" id="profile-email"></span></div>
          <div class="profile-field"><span class="profile-label">ID do Usuário:</span><span class="profile-value" id="profile-uid"></span></div>
          <div class="profile-field"><span class="profile-label">Data de Criação:</span><span class="profile-value" id="profile-created"></span></div>
        </div>
      </div>
      <div class="modal-footer"><button class="modal-action btn-secondary" id="profile-modal-close-btn">Fechar</button></div>
    </div>
  </div>

  <script>
  (function() {
    // Configuração do Firebase (substitua pelos dados do seu projeto se necessário)
  const firebaseConfig = {
    apiKey: "AIzaSyCUxgrebbln4tS-0ZkBFgRJd_TPxlF9nxg",
    authDomain: "codivio-32573207520375023545.firebaseapp.com",
    projectId: "codivio-32573207520375023545",
    storageBucket: "codivio-32573207520375023545.firebasestorage.app",
    messagingSenderId: "845641232484",
    appId: "1:845641232484:web:cf0ab0ad3f0897db10af71"
  };

    firebase.initializeApp(firebaseConfig);
    const auth = firebase.auth();
    const db = firebase.firestore();

    const el = {
      code: document.getElementById('code'),
      preview: document.getElementById('preview'),
      run: document.getElementById('run'),
      reset: document.getElementById('reset'),
      download: document.getElementById('download'),
      auto: document.getElementById('auto'),
      status: document.getElementById('status'),
      popup: document.getElementById('popup'),
      noteBtns: Array.from(document.querySelectorAll('[data-note]')),
      lnContent: document.getElementById('lnContent'),
      // Auth
      authModal: document.getElementById('auth-modal'),
      modalClose: document.getElementById('modal-close'),
      loginForm: document.getElementById('login-form'),
      registerForm: document.getElementById('register-form'),
      authTabs: document.querySelectorAll('.auth-tab'),
      authSubmit: document.getElementById('auth-submit'),
      authSwitch: document.getElementById('auth-switch'),
      loginBtn: document.getElementById('login-btn'),
      userSection: document.getElementById('user-section'),
      userBtn: document.getElementById('user-btn'),
      userDropdown: document.getElementById('user-dropdown'),
      userName: document.getElementById('user-name'),
      logoutBtn: document.getElementById('logout-btn'),
      profileBtn: document.getElementById('profile-btn'),
      // Campos
      loginEmail: document.getElementById('login-email'),
      loginPassword: document.getElementById('login-password'),
      registerName: document.getElementById('register-name'),
      registerEmail: document.getElementById('register-email'),
      registerPassword: document.getElementById('register-password'),
      registerConfirm: document.getElementById('register-confirm'),
      // Erros
      loginError: document.getElementById('login-error'),
      registerError: document.getElementById('register-error'),
      // Perfil
      profileModal: document.getElementById('profile-modal'),
      profileModalClose: document.getElementById('profile-modal-close'),
      profileModalCloseBtn: document.getElementById('profile-modal-close-btn'),
      profileName: document.getElementById('profile-name'),
      profileEmail: document.getElementById('profile-email'),
      profileUid: document.getElementById('profile-uid'),
      profileCreated: document.getElementById('profile-created')
    };

    const TEMPLATE = `<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Exemplo de Página HTML</title>
</head>
<body>
  <h1>Olá, Mundo!</h1>
  <p>Esta é uma página HTML simples.</p>
</body>
</html>`;

    let currentUser = null;
    let isLoginMode = true;
    let dirty = false;
    let activeNote = Number(localStorage.getItem('activeNote')) || 1;

    // Utilidades
    const debounce = (fn, ms = 300) => {
      let t;
      return (...args) => { clearTimeout(t); t = setTimeout(() => fn(...args), ms); };
    };

    function updateStatus(extra = '') {
      const time = new Date().toLocaleTimeString();
      el.status.textContent = `Atualizado (Nota ${activeNote}) às ${time}${extra ? ' • ' + extra : ''}`;
    }

    function updatePreview(src) {
      el.preview.srcdoc = src;
      updateStatus();
    }

    function setActiveNoteUI() {
      el.noteBtns.forEach((b) => b.classList.toggle('active', Number(b.dataset.note) === activeNote));
    }

    function updateLineNumbers() {
      const total = Math.max(1, el.code.value.split('\n').length);
      el.lnContent.textContent = Array.from({ length: total }, (_, i) => i + 1).join('\n');
    }

    function syncLineScroll() {
      el.lnContent.style.transform = `translateY(-${el.code.scrollTop}px)`;
    }

    function showAuthModal(){ el.authModal.style.display = 'flex'; }
    function hideAuthModal(){ el.authModal.style.display = 'none'; clearFormErrors(); }

    function showProfileModal(){ if(!currentUser) return; loadProfileData(); el.profileModal.style.display = 'flex'; }
    function hideProfileModal(){ el.profileModal.style.display = 'none'; }

    function switchAuthMode(){
      isLoginMode = !isLoginMode;
      if(isLoginMode){
        el.loginForm.style.display = 'block';
        el.registerForm.style.display = 'none';
        el.authSubmit.textContent = 'Entrar';
        el.authSwitch.textContent = 'Criar uma conta';
        document.querySelector('[data-tab="login"]').classList.add('active');
        document.querySelector('[data-tab="register"]').classList.remove('active');
      } else {
        el.loginForm.style.display = 'none';
        el.registerForm.style.display = 'block';
        el.authSubmit.textContent = 'Criar Conta';
        el.authSwitch.textContent = 'Já tenho uma conta';
        document.querySelector('[data-tab="register"]').classList.add('active');
        document.querySelector('[data-tab="login"]').classList.remove('active');
      }
      clearFormErrors();
    }

    function clearFormErrors(){ document.querySelectorAll('.form-error').forEach(e=>{ e.classList.remove('show'); e.textContent=''; }); }
    function showError(element, message){ element.textContent = message; element.classList.add('show'); }

    async function handleLogin(){
      const email = el.loginEmail.value.trim();
      const password = el.loginPassword.value;
      clearFormErrors();
      if(!email){ return showError(el.loginError,'Por favor, informe seu e-mail.'); }
      if(!password){ return showError(el.loginError,'Por favor, informe sua senha.'); }
      try {
        const result = await auth.signInWithEmailAndPassword(email, password);
        currentUser = result.user;
        hideAuthModal();
        updateUIForUser();
        await loadUserNotes();
      } catch (error) {
        showError(el.loginError, getAuthErrorMessage(error.code));
      }
    }

    async function handleRegister(){
      const name = el.registerName.value.trim();
      const email = el.registerEmail.value.trim();
      const password = el.registerPassword.value;
      const confirm = el.registerConfirm.value;
      clearFormErrors();
      if(!name) return showError(el.registerError,'Por favor, informe seu nome.');
      if(!email) return showError(el.registerError,'Por favor, informe seu e-mail.');
      if(!password) return showError(el.registerError,'Por favor, crie uma senha.');
      if(password !== confirm) return showError(el.registerError,'As senhas não coincidem.');
      if(password.length < 6) return showError(el.registerError,'A senha deve ter pelo menos 6 caracteres.');
      try {
        const result = await auth.createUserWithEmailAndPassword(email, password);
        await db.collection('users').doc(result.user.uid).set({
          name, email, createdAt: firebase.firestore.FieldValue.serverTimestamp()
        });
        currentUser = result.user;
        // Opcional: setar displayName
        try { await result.user.updateProfile({ displayName: name }); } catch {}
        hideAuthModal();
        updateUIForUser();
        await loadUserNotes();
      } catch (error) {
        showError(el.registerError, getAuthErrorMessage(error.code));
      }
    }

    async function handleLogout(){
      try {
        await auth.signOut();
        currentUser = null;
        updateUIForUser();
        el.code.value = loadLocal(activeNote);
        updateLineNumbers();
        run();
      } catch (error) { console.error('Erro ao fazer logout:', error); }
    }

    function getAuthErrorMessage(code){
      switch(code){
        case 'auth/invalid-email': return 'E-mail inválido.';
        case 'auth/user-disabled': return 'Esta conta foi desativada.';
        case 'auth/user-not-found': return 'Nenhuma conta encontrada com este e-mail.';
        case 'auth/wrong-password': return 'Senha incorreta.';
        case 'auth/email-already-in-use': return 'Este e-mail já está em uso.';
        case 'auth/weak-password': return 'A senha é muito fraca.';
        default: return 'Ocorreu um erro. Tente novamente.';
      }
    }

    function updateUIForUser(){
      if(currentUser){
        el.loginBtn.style.display = 'none';
        el.userSection.style.display = 'block';
        el.userName.textContent = currentUser.displayName || currentUser.email;
      } else {
        el.loginBtn.style.display = 'block';
        el.userSection.style.display = 'none';
      }
    }

    function toggleUserDropdown(){ el.userDropdown.classList.toggle('show'); }

    async function loadProfileData(){
      if(!currentUser) return;
      try {
        const doc = await db.collection('users').doc(currentUser.uid).get();
        if(doc.exists){
          const d = doc.data();
          el.profileName.textContent = d.name || 'Não definido';
          el.profileEmail.textContent = currentUser.email;
          el.profileUid.textContent = currentUser.uid;
          el.profileCreated.textContent = d.createdAt ? d.createdAt.toDate().toLocaleDateString('pt-BR') : 'Não disponível';
        } else {
          el.profileName.textContent = currentUser.displayName || 'Não definido';
          el.profileEmail.textContent = currentUser.email;
          el.profileUid.textContent = currentUser.uid;
          el.profileCreated.textContent = 'Não disponível';
        }
      } catch (e) {
        console.error('Erro ao carregar dados do perfil:', e);
        el.profileName.textContent = currentUser.displayName || 'Não definido';
        el.profileEmail.textContent = currentUser.email;
        el.profileUid.textContent = currentUser.uid;
        el.profileCreated.textContent = 'Erro ao carregar';
      }
    }

    // Persistência de notas
    async function saveUserNote(noteId, content){
      if(!currentUser) return;
      try {
        await db.collection('users').doc(currentUser.uid).collection('notes').doc(String(noteId)).set({
          content,
          updatedAt: firebase.firestore.FieldValue.serverTimestamp()
        });
      } catch (e){ console.error('Erro ao salvar nota:', e); el.status.textContent = 'Erro ao salvar nota.'; }
    }

    async function loadUserNote(noteId){
      if(!currentUser) return TEMPLATE;
      try {
        const doc = await db.collection('users').doc(currentUser.uid).collection('notes').doc(String(noteId)).get();
        return doc.exists ? (doc.data().content || TEMPLATE) : TEMPLATE;
      } catch (e){ console.error('Erro ao carregar nota:', e); return TEMPLATE; }
    }

    async function loadUserNotes(){
      if(!currentUser) return;
      const content = await loadUserNote(activeNote);
      el.code.value = content;
      updateLineNumbers();
      run();
    }

    // LocalStorage para anônimo
    function loadLocal(n){
      const legacy = localStorage.getItem('mini-html-editor');
      const hasNote = localStorage.getItem(`note-${n}`);
      return hasNote || (n === 1 && legacy) || TEMPLATE;
    }
    function saveLocal(n, val){ localStorage.setItem(`note-${n}`, val); }

    // Execução
    function run(){
      const html = el.code.value;
      if(currentUser){ saveUserNote(activeNote, html); } else { saveLocal(activeNote, html); }
      updatePreview(html);
      dirty = false;
    }

    function reset(){
      if(!confirm(`Limpar a Nota ${activeNote} e voltar ao modelo inicial?`)) return;
      el.code.value = TEMPLATE;
      updateLineNumbers();
      run();
    }

    function download(){
      const blob = new Blob([el.code.value], { type: 'text/html;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = `index-nota-${activeNote}.html`;
      document.body.appendChild(a); a.click(); a.remove();
      URL.revokeObjectURL(url);
    }

    function popup(){
      const win = window.open('', '_blank');
      if(win){ win.document.open(); win.document.write(el.code.value); win.document.close(); }
      else { alert('Permita pop-ups para abrir em nova aba.'); }
    }

    // Troca de nota — corrigido para NÃO sobrescrever no Firestore
    async function switchNote(n){
      n = Number(n);
      if(n === activeNote) return;
      if(!el.auto.checked && dirty){
        const choice = confirm('Deseja salvar as alterações da nota atual antes de trocar?');
        if(choice) run(); else { dirty = false; updateStatus('alterações descartadas'); }
      }
      activeNote = n;
      localStorage.setItem('activeNote', n);

      if(currentUser){
        const content = await loadUserNote(n); // busca do Firestore antes de preencher
        el.code.value = content;
      } else {
        el.code.value = loadLocal(n);
      }
      updateLineNumbers();
      run();
      setActiveNoteUI();
      syncLineScroll();
    }

    // Listeners
    el.run.addEventListener('click', run);
    el.reset.addEventListener('click', reset);
    el.download.addEventListener('click', download);
    el.popup.addEventListener('click', popup);

    const onType = debounce(() => { if(el.auto.checked) run(); }, 300);
    el.code.addEventListener('input', () => { dirty = true; updateLineNumbers(); onType(); });
    el.code.addEventListener('scroll', syncLineScroll);
    el.auto.addEventListener('change', () => { el.run.disabled = el.auto.checked; if(el.auto.checked) run(); });
    el.run.disabled = el.auto.checked;

    el.noteBtns.forEach(btn => btn.addEventListener('click', () => switchNote(btn.dataset.note)));

    el.code.addEventListener('keydown', (e) => {
      if(e.key === 'Tab'){
        e.preventDefault();
        const start = el.code.selectionStart; const end = el.code.selectionEnd; const val = el.code.value;
        el.code.value = val.slice(0, start) + '  ' + val.slice(end);
        el.code.selectionStart = el.code.selectionEnd = start + 2;
        dirty = true; updateLineNumbers(); if(el.auto.checked) onType();
      }
    });

    // Auth listeners
    el.loginBtn.addEventListener('click', showAuthModal);
    el.modalClose.addEventListener('click', hideAuthModal);
    el.authTabs.forEach(tab => tab.addEventListener('click', () => {
      if(tab.dataset.tab === 'login' && !isLoginMode) switchAuthMode();
      if(tab.dataset.tab === 'register' && isLoginMode) switchAuthMode();
    }));
    el.authSubmit.addEventListener('click', () => { isLoginMode ? handleLogin() : handleRegister(); });
    el.authSwitch.addEventListener('click', switchAuthMode);

    el.userBtn.addEventListener('click', (e) => { e.stopPropagation(); toggleUserDropdown(); });
    el.logoutBtn.addEventListener('click', handleLogout);
    el.profileBtn.addEventListener('click', showProfileModal);
    el.profileModalClose.addEventListener('click', hideProfileModal);
    el.profileModalCloseBtn.addEventListener('click', hideProfileModal);

    // Fechar dropdown ao clicar fora — corrigido e seguro
    document.addEventListener('click', (e) => {
      if(el.userDropdown.classList.contains('show') && !document.getElementById('auth-section').contains(e.target)){
        el.userDropdown.classList.remove('show');
      }
    });

    // Estado de autenticação
    auth.onAuthStateChanged(async (user) => {
      currentUser = user || null;
      updateUIForUser();
      if(user){ await loadUserNotes(); }
      else {
        el.code.value = loadLocal(activeNote);
        updateLineNumbers();
        run();
      }
    });

    // Inicialização: carrega local primeiro; se o usuário autenticar, o onAuthStateChanged substitui
    el.code.value = loadLocal(activeNote);
    updateLineNumbers();
    run();
    setActiveNoteUI();
    syncLineScroll();
  })();
  </script>

  <!--
  Firestore Rules sugeridas (Console > Firestore > Rules):

  rules_version = '2';
  service cloud.firestore {
    match /databases/{database}/documents {
      match /users/{userId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        match /notes/{noteId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }
  }
  -->
</body>
</html>
